SERVICE_HOST = "0.0.0.0"
SERVICE_PORT = 62050
XRAY_API_HOST = "127.0.0.1"
XRAY_API_PORT = 62051
NORA_DATA_DIR = /var/lib/nora-node
# XRAY_EXECUTABLE_PATH = /var/lib/nora-node/xray-core/xray
# XRAY_ASSETS_PATH = /var/lib/nora-node/xray-core
# OpenVPN is supported only in binary install mode. Docker nodes reject OpenVPN runtime settings.
# WireGuard is supported only in binary install mode. The node installs wireguard-tools/nftables,
# loads the kernel module and routes each inbound to its Xray tunnel port with TPROXY by default.
# Direct NAT is opt-in with nat_enabled=true. Docker nodes reject WireGuard runtime settings.

# NODE_VERSION = "1.0.0"
# Nora-node maintenance service
# NORA_NODE_SCRIPT_SCHEME = "http"
# NORA_NODE_SCRIPT_HOST = "127.0.0.1"
# NORA_NODE_SCRIPT_PORT = 3100
# NORA_NODE_SCRIPT_ALLOWED_HOSTS = "127.0.0.1,::1,localhost"
# NORA_NODE_SCRIPT_BIN = "/usr/local/bin/nora-node"

SSL_CERT_FILE = /var/lib/nora-node/ssl_cert.pem
SSL_KEY_FILE = /var/lib/nora-node/ssl_key.pem
SSL_CLIENT_CERT_FILE = /var/lib/nora-node/ssl_client_cert.pem

### for developers
# DEBUG = false

### Select Specific Inbounds
# INBOUNDS = "VLESS TCP REALITY, VMESS TCP NO TLS"
